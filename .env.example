APP_ENV=development
APP_ORIGIN=http://localhost:3000
PORT=3000
BIND_HOST=127.0.0.1
TRUST_PROXY=0

# Copia la URL de Connect en Supabase. Usa la conexión directa o el pooler de sesión.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL_CA_FILE=

SESSION_TTL_HOURS=8
# Para producción, cambia APP_ORIGIN a HTTPS y COOKIE_SECURE a true.
COOKIE_SECURE=false
CSRF_SECRET=ejemplo-local-csrf-solo-para-desarrollo
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Valores ficticios para desarrollo. DEMO_MAILBOX_* protege /dev/bandeja (correos simulados).
# SEED_DEMO_PASSWORD es la clave de las cuentas de seed:demo (mínimo 10 caracteres).
DEMO_LOGIN_ENABLED=false
DEMO_MAILBOX_ENABLED=true
DEMO_MAILBOX_PASSWORD=ejemplo-bandeja-local
SEED_DEMO_PASSWORD=ejemplo-semilla-local

# Solo en producción. Configura ambas variables para habilitar la recuperación por Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
