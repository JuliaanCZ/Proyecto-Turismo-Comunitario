# Copia a .env para desarrollo local.
PORT=3000
# Para el despliegue local detrás de Caddy, usa BIND_HOST=127.0.0.1.
BIND_HOST=
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Copia la cadena del pooler en modo sesión (puerto 5432) y reemplaza solo el marcador de contraseña.
DATABASE_URL=postgresql://postgres.vuwkqxncaxuvnnpxznvz:[YOUR-DATABASE-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://vuwkqxncaxuvnnpxznvz.supabase.co
# Clave secreta de servidor de Supabase; nunca se expone en public/ ni se versiona .env.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVER-KEY]
WHATSAPP_BOOKING_NUMBER=

SESSION_TTL_HOURS=8
COOKIE_SECURE=false
TRUST_PROXY=0
# Valor ficticio para desarrollo. Sustituir por un secreto aleatorio en producción.
CSRF_SECRET=ejemplo-local-csrf-solo-para-desarrollo

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Valores ficticios para uso local. La bandeja se implementa en un bloque posterior.
DEMO_MAILBOX_ENABLED=true
DEMO_MAILBOX_PASSWORD=ejemplo-bandeja-local
SEED_DEMO_PASSWORD=ejemplo-semilla-local

# Certificado CA descargado de Supabase > Database Settings > SSL Configuration.
DATABASE_SSL_CA_FILE=
