{
  "name": "turismo-comunitario",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo de turismo comunitario de Ecuador",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/start.js",
    "dev": "node --watch --env-file=.env src/start.js",
