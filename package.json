    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "pg-mem": "^3.0.14",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2"
  }
