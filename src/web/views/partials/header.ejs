<%
  const ruta = locals.currentPath ?? '';
  const panel = ruta.startsWith('/panel');
  const actual = (base) => (ruta === base || (base !== '/' && base !== '/panel' && ruta.startsWith(base + '/'))) ? ' aria-current="page"' : '';
%>
<header class="cabecera k-header">
  <div class="contenedor cabecera__interior">
    <% if (ruta !== '/') { %>
      <a class="k-brand" href="/"><span class="k-mark"><%- include('icon', { name: 'mark' }) %></span><span>Kawsay Ñan<% if (panel) { %><small>Turismo comunitario</small><% } %></span></a>
    <% } %>
    <nav aria-label="Principal"><ul class="nav">
      <li><a href="<%= panel ? '/panel' : '/' %>"<%- actual(panel ? '/panel' : '/') %>><% if (panel) { %><%- include('icon', { name: 'home' }) %><% } %>Inicio</a></li>
      <% if (!panel) { %><li><a href="/ofertas"<%- actual('/ofertas') %>>Explorar</a></li><% } %>
      <% if (locals.principal) { %>
        <li><a href="/panel/ofertas"<%- actual('/panel/ofertas') %>><% if (panel) { %><%- include('icon', { name: 'ticket' }) %><% } %>Mis ofertas</a></li>
        <li><a href="/panel/chat"<%- actual('/panel/chat') %>><% if (panel) { %><%- include('icon', { name: 'chat' }) %><% } %>Chat<span id="chat-badge" class="insignia" hidden></span></a></li>
      <% } %>
    </ul></nav>
    <% if (panel) { %><span class="k-panel-rail-label" aria-hidden="true">Ecuador · Panel de gestión</span><% } %>
    <% if (locals.principal) { %><div class="k-account">
      <% if (panel) { %><div class="k-account-name"><span aria-hidden="true"><%= principal.displayName.trim().split(/\s+/).slice(0, 2).map(word => word[0]).join('') %></span><strong><%= principal.displayName %></strong></div><% } %>
      <form method="post" action="/salir"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--secundario">Salir</button></form>
    </div><% } else { %><a class="k-login" href="/ingreso">Iniciar sesión</a><% } %>
  </div>
</header>
