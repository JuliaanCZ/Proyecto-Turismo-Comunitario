<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${title} · Turismo comunitario` : 'Turismo comunitario' %></title>
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/form-validate.js"></script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <%- include('partials/header') %>
  <main id="contenido" class="contenedor principal" tabindex="-1">
<%- body %>
  </main>
  <footer class="pie">
    <div class="contenedor">
      <p>Proyecto académico de Aplicaciones Web Avanzadas. Los datos de ejemplo son ficticios.</p>
    </div>
  </footer>
  <%# Aviso de nuevo mensaje (B1.10): con sesión y fuera de /panel/chat, donde ya hay un socket unido a la sala. %>
  <% if (locals.principal && (locals.currentPath ?? '').toLowerCase().replace(/\/+$/, '') !== '/panel/chat') { %>
  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/js/notificaciones.js"></script>
  <% } %>
</body>
</html>
