<div class="k-list-title"><div><p class="k-eyebrow k-lined">Catálogo propio</p><h1>Mis ofertas</h1></div><a class="btn" href="/panel/ofertas/nueva">＋ Nueva oferta</a></div>
<form method="get" action="/panel/ofertas" class="campo k-own-filter">
  <div class="k-own-filter-control"><label class="campo__etiqueta" for="provincia">Provincia</label>
  <select id="provincia" name="provincia">
    <option value="">Todas las provincias</option>
    <% for (const province of provinces) { %>
    <option value="<%= province.code %>"<% if (result.provincia === province.code) { %> selected<% } %>><%= province.label %></option>
    <% } %>
  </select>
  <button class="btn btn--secundario" type="submit">Filtrar</button>
  <% if (result.provincia) { %><a href="/panel/ofertas">Quitar filtro</a><% } %>
</div><small class="k-own-count"><%= result.total ? 'Mostrando ' + ((result.page - 1) * result.pageSize + 1) + '–' + ((result.page - 1) * result.pageSize + result.items.length) + ' de ' + result.total : '0 ofertas' %></small>
</form>
<% if (aviso) { %><p class="mensaje mensaje--exito" role="status">Listo: <%= aviso %></p><% } %>
<% if (!result.items.length) { %>
<section class="vacio"><h2>No hay ofertas en esta lista</h2>
<p>Prueba otra provincia o crea una nueva oferta.</p><a href="/panel/ofertas/nueva">Nueva oferta</a></section>
<% } else { %>
<ul class="k-own-list">
  <% for (const offer of result.items) { %>
  <li>
    <%- include('../partials/date-tile', { offer }) %>
    <div><h2><a href="/panel/ofertas/<%= offer.id %>"><%= offer.title %></a></h2>
    <p class="k-own-meta"><span class="k-eyebrow"><%= offer.provinceLabel %></span><span><%- include('../partials/icon', { name: 'pin' }) %><%= offer.locationText %></span><span><%- include('../partials/icon', { name: 'clock' }) %><%= formatEcuadorDateTime(offer.startsAt) %></span><span><%- include('../partials/icon', { name: 'people' }) %>Cupo <%= offer.capacity %></span><span><%= offer.isPublished ? 'Publicada' : 'Borrador' %></span></p></div>
    <div class="acciones"><a href="/panel/ofertas/<%= offer.id %>/editar" aria-label="Editar <%= offer.title %>" title="Editar"><%- include('../partials/icon', { name: 'edit' }) %></a><a href="/panel/ofertas/<%= offer.id %>/eliminar" aria-label="Eliminar <%= offer.title %>" title="Eliminar"><%- include('../partials/icon', { name: 'trash' }) %></a></div>
  </li>
  <% } %>
</ul>
<% } %>
<% if (result.totalPages > 1) { %>
<nav aria-label="Páginas de mis ofertas"><ul class="acciones">
  <% for (let page = 1; page <= result.totalPages; page += 1) { %>
  <li><a href="<%= pageLink(page, result.provincia) %>"<% if (page === result.page) { %> aria-current="page"<% } %>><%= page %></a></li>
  <% } %>
</ul></nav>
<% } %>
