<h1><%= offer.title %></h1>
<% if (aviso) { %><p class="mensaje mensaje--exito" role="status">Listo: <%= aviso %></p><% } %>
<p><strong>Estado:</strong> <%= offer.isPublished ? 'Publicada' : 'Borrador' %></p>
<p><%= offer.description %></p>
<dl class="oferta__datos"><dt>Provincia</dt><dd><%= offer.provinceLabel %></dd>
<dt>Ubicación</dt><dd><%= offer.locationText %></dd>
<dt>Fecha</dt><dd><%= formatEcuadorDateTime(offer.startsAt) %></dd>
<dt>Cupo referencial</dt><dd><%= offer.capacity %></dd></dl>
<% if (offer.hasPhoto) { %><img src="/panel/ofertas/<%= offer.id %>/foto" alt="<%= photoAltText %>" class="oferta__imagen" width="640"><% } %>
<div class="acciones"><a class="btn" href="/panel/ofertas/<%= offer.id %>/editar">Editar</a>
<a class="btn btn--peligro" href="/panel/ofertas/<%= offer.id %>/eliminar">Eliminar</a>
<a class="btn btn--secundario" href="/panel/ofertas">Volver al listado</a></div>
<section aria-labelledby="foto-titulo"><h2 id="foto-titulo"><%= offer.hasPhoto ? 'Reemplazar foto' : 'Añadir foto' %></h2>
<p>Una imagen JPEG, PNG o WebP de hasta 2 MiB. El texto alternativo describe lo que muestra.</p>
<form action="/panel/ofertas/<%= offer.id %>/foto" method="post" enctype="multipart/form-data" data-offer-photo data-csrf-token="<%= csrfToken %>">
<div class="campo"><label class="campo__etiqueta" for="foto">Foto</label>
<input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" required aria-describedby="foto-error">
<p class="campo__error" id="foto-error" data-error-for="imageBytes" aria-live="polite"></p></div>
<%- include('../partials/form-field', { name: 'altText', label: 'Texto alternativo', required: true, errors: [] }) %>
<p class="mensaje mensaje--error" role="alert" tabindex="-1" data-photo-status hidden></p>
<button class="btn" type="submit">Guardar foto</button>
</form></section>
<script type="module" src="/js/oferta-foto.js"></script>
