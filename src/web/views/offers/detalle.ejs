<h1><%= offer.title %></h1>
<% if (aviso) { %><p class="mensaje mensaje--exito" role="status">Listo: <%= aviso %></p><% } %>
<p><strong>Estado:</strong> <%= offer.isPublished ? 'Publicada' : 'Borrador' %></p>
<p><%= offer.description %></p>
<dl class="oferta__datos"><dt>Provincia</dt><dd><%= offer.provinceLabel %></dd>
<dt>Ubicación</dt><dd><%= offer.locationText %></dd>
<dt>Fecha</dt><dd><%= formatEcuadorDateTime(offer.startsAt) %></dd>
<dt>Cupo referencial</dt><dd><%= offer.capacity %></dd></dl>
<% if (offer.hasPhoto) { %><img src="/panel/ofertas/<%= offer.id %>/foto" alt="<%= photoAltText %>" class="oferta__imagen" width="640"><% } %>
<div class="acciones"><a class="btn" href="/panel/ofertas/<%= offer.id %>/editar">Editar</a>
<a class="btn btn--peligro" href="/panel/ofertas/<%= offer.id %>/eliminar">Eliminar</a>
<a class="btn btn--secundario" href="/panel/ofertas">Volver al listado</a></div>
