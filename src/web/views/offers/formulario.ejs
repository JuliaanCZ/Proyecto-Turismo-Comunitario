<% const published = [true, 'true'].includes(values.isPublished ?? offer?.isPublished); %>
<p class="k-eyebrow">Mis ofertas</p>
<h1><%= offer ? 'Editar oferta' : 'Nueva oferta' %></h1>
<p>El cupo es referencial. El organizador confirma la disponibilidad por WhatsApp o correo.</p>
<p class="campo__ayuda">Los campos con asterisco (<span class="campo__obligatorio">*</span>) son obligatorios.</p>
<% if (message) { %><p class="mensaje mensaje--error" role="alert" tabindex="-1">Error: <%= message %></p><% } %>
<form method="post" enctype="multipart/form-data" data-gallery-form action="<%= offer ? '/panel/ofertas/' + offer.id + '/editar' : '/panel/ofertas' %>" data-schema="<%= JSON.stringify(offerSchema) %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../partials/form-field', { name: 'title', label: 'Título', value: values.title, required: true, errors: errors.title }) %>
  <%- include('../partials/form-field', { name: 'description', label: 'Descripción', type: 'textarea', rows: 6, value: values.description, required: true, errors: errors.description }) %>
  <div class="campo<%= errors.province?.length ? ' campo--error' : '' %>">
    <label class="campo__etiqueta" for="campo-province">Provincia <span class="campo__obligatorio" aria-hidden="true">*</span></label>
    <select id="campo-province" name="province" aria-describedby="campo-province-error" required<% if (errors.province?.length) { %> aria-invalid="true"<% } %>>
      <option value="">Elige una provincia</option>
      <% for (const province of provinces) { %><option value="<%= province.code %>"<% if (values.province === province.code) { %> selected<% } %>><%= province.label %></option><% } %>
    </select>
    <p class="campo__error" id="campo-province-error" data-error-for="province" aria-live="polite"><%= (errors.province ?? []).join(' ') %></p>
  </div>
  <%- include('../partials/form-field', { name: 'locationText', label: 'Ubicación', value: values.locationText, required: true, errors: errors.locationText }) %>
  <%- include('../partials/form-field', { name: 'startsAt', label: 'Fecha y hora', type: 'datetime-local', value: values.startsAt, required: true, hint: 'Hora de Ecuador continental', errors: errors.startsAt }) %>
  <%- include('../partials/form-field', { name: 'capacity', label: 'Cupo referencial', type: 'number', value: values.capacity, required: true, inputmode: 'numeric', errors: errors.capacity }) %>
  <div class="campo<%= errors.isPublished?.length ? ' campo--error' : '' %>">
    <label class="campo__etiqueta" for="campo-isPublished">Publicación</label>
    <select id="campo-isPublished" name="isPublished" aria-describedby="campo-isPublished-ayuda campo-isPublished-error">
      <option value="false"<% if (!published) { %> selected<% } %>>Borrador</option>
      <option value="true"<% if (published) { %> selected<% } %>>Publicada</option>
    </select>
    <p class="campo__ayuda" id="campo-isPublished-ayuda">Para publicar, indica un teléfono y un correo de contacto y conserva o añade al menos una foto.</p>
    <p class="campo__error" id="campo-isPublished-error" data-error-for="isPublished" aria-live="polite"><%= (errors.isPublished ?? []).join(' ') %></p>
  </div>
  <%- include('../partials/form-field', { name: 'contactPhone', label: 'Teléfono / WhatsApp', type: 'tel', value: values.contactPhone, hint: 'Móvil ecuatoriano o número con prefijo internacional', required: published, requiredOnPublish: true, errors: errors.contactPhone }) %>
  <%- include('../partials/form-field', { name: 'contactEmail', label: 'Correo de contacto', type: 'email', value: values.contactEmail, required: published, requiredOnPublish: true, errors: errors.contactEmail }) %>
  <% if (offer) { %><input type="hidden" name="revision" value="<%= offer.updatedAt %>"><% } %>
  <fieldset class="k-gallery-form"><legend>Fotos del lugar <span data-publish-marker<% if (!published) { %> hidden<% } %>><span class="campo__obligatorio" aria-hidden="true">*</span><span class="sr-only">(al menos una para publicar)</span></span></legend>
    <p>Hasta cinco fotos JPEG, PNG o WebP. Escribe un texto alternativo para cada foto nueva. La primera foto que guardes será la portada.</p>
    <% for (const photo of gallery) { %>
      <label class="k-retained"><img src="/panel/ofertas/<%= offer.id %>/foto/<%= photo.position %>" alt="<%= photo.altText %>">
      <input type="checkbox" name="keep<%= photo.position %>" checked> Conservar esta foto</label>
    <% } %>
    <% for (let n = 1; n <= 5; n++) { %>
      <div class="k-gallery-slot" data-gallery-slot <%= n > 1 ? 'hidden' : '' %>>
        <label>Foto nueva <%= n %><input type="file" name="photo<%= n %>" accept="image/jpeg,image/png,image/webp"></label>
        <label><span>Texto alternativo <span class="campo__obligatorio" data-alt-marker aria-hidden="true" hidden>*</span></span><input type="text" name="alt<%= n %>" maxlength="160"></label>
        <img alt="Vista previa" hidden>
      </div>
    <% } %>
    <button type="button" class="btn btn--secundario" data-add-gallery-slot>Añadir otra foto</button>
  </fieldset>
  <p class="mensaje mensaje--error" role="alert" tabindex="-1" data-gallery-status hidden></p>
  <div class="acciones"><button class="btn" type="submit">Guardar oferta</button><a class="btn btn--secundario" href="<%= offer ? '/panel/ofertas/' + offer.id : '/panel/ofertas' %>">Cancelar</a></div>
</form>

<script type="module" src="/js/kawsay-offer.js"></script>
