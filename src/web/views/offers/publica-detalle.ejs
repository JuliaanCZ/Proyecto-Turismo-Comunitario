<p class="k-back"><a href="/ofertas?region=<%= offer.region.key %>">← Volver a <%= offer.region.name %></a></p>
<header class="k-banner k-detail-hero">
  <img src="/ofertas/<%= offer.id %>/foto" alt="<%= gallery[0]?.altText ?? '' %>">
  <div class="k-shade"></div>
  <div class="k-banner-content"><span class="k-chip"><%= offer.region.name %> · <%= offer.provinceLabel %></span><h1><%= offer.title %></h1></div>
</header>
<div class="k-detail">
  <article class="k-paper"><h2 class="k-eyebrow">La experiencia</h2><p class="k-description"><%= offer.description %></p>
    <p class="k-organizer">Organiza <strong><%= offer.organizerName %></strong></p>
    <% if (gallery.length > 1) { %><h2>Fotos del lugar</h2><ul class="k-gallery"><% for (const photo of gallery) { %>
      <li><a href="/ofertas/<%= offer.id %>/foto/<%= photo.position %>"><img src="/ofertas/<%= offer.id %>/foto/<%= photo.position %>" alt="<%= photo.altText %>" loading="lazy"></a></li>
    <% } %></ul><% } %>
  </article>
  <aside class="k-detail-aside">
    <section class="k-date-panel"><h2>Fecha de salida</h2><p><%= formatEcuadorDateTime(offer.startsAt) %></p><small>Hora de Ecuador continental</small></section>
    <section class="k-paper"><dl><dt>Punto de encuentro</dt><dd><%= offer.locationText %></dd><dt>Cupo referencial</dt><dd><%= offer.capacity %> personas</dd></dl>
    <h2>Contacto</h2>
    <% const demo = offer.contactEmail?.endsWith('@demo.test'); %>
    <% if (demo) { %><p>Datos ficticios para demostración.</p><% } %>
    <% if (offer.contactPhone) { %><p><%= offer.contactPhone %></p><% } %>
    <% if (offer.contactEmail) { %><p><%= offer.contactEmail %></p><% } %>
    <div class="acciones">
      <% if (whatsappUrl) { %><a class="btn" href="<%= whatsappUrl %>" rel="noopener noreferrer">Consultar por WhatsApp</a><% } %>
      <% if (offer.contactEmail && !demo) { %><a class="btn btn--secundario" href="mailto:<%= encodeURIComponent(offer.contactEmail).replace('%40', '@') %>">Escribir por correo</a><% } %>
    </div>
    <% if (!offer.contactPhone && !offer.contactEmail) { %><p>Contacto aún no disponible.</p><% } %>
    </section>
  </aside>
</div>
