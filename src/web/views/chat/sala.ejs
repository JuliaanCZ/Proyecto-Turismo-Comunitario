<p class="k-eyebrow k-lined">Sala general</p><h1>Chat del equipo</h1>
<div class="k-chat-layout"><div>
<section class="chat" aria-labelledby="chat-history-title">
  <div class="chat__cabecera">
    <h2 id="chat-history-title" class="sr-only">Mensajes</h2>
    <button id="chat-load-before" class="btn btn--secundario" type="button"<%= hasMore ? '' : ' hidden' %>>Cargar anteriores</button>
  </div>

  <p id="chat-empty" class="vacio"<%= messages.length ? ' hidden' : '' %>>Todavía no hay mensajes. Escribe el primero.</p>
  <ol
    id="chat-messages"
    class="chat__mensajes"
    role="log"
    aria-live="polite"
    aria-relevant="additions"
    data-first-id="<%= firstMessageId %>"
    data-last-id="<%= lastMessageId %>"
    data-current-user-id="<%= principal.userId %>"
  >
    <% for (const message of messages) { %>
    <li class="chat__mensaje<%= message.author.id === principal.userId ? ' chat__mensaje--propio' : '' %>" data-message-id="<%= message.id %>" data-client-message-id="<%= message.clientMessageId %>">
      <div class="chat__mensaje-meta">
        <strong><%= message.author.displayName %></strong>
        <time datetime="<%= message.createdAtIso %>"><%= message.createdAtLabel %></time>
        <% if (message.author.id === principal.userId) { %><span class="chat__estado">Confirmado</span><% } %>
      </div>
      <p><%= message.text %></p>
    </li>
    <% } %>
  </ol>
</section>

<form id="chat-form" class="formulario chat__formulario">
  <div class="campo">
    <label class="sr-only" for="chat-text">Mensaje <span class="campo__obligatorio" aria-hidden="true">*</span></label>
    <textarea id="chat-text" name="text" rows="2" placeholder="Escribe un mensaje…" required aria-describedby="chat-count chat-error"></textarea>
    <p id="chat-count" class="campo__ayuda">0 de 500 caracteres</p>
    <p id="chat-error" class="campo__error" role="alert"></p>
  </div>
  <button id="chat-submit" class="btn" type="submit" aria-label="Enviar mensaje" title="Enviar mensaje"><%- include('../partials/icon', { name: 'send' }) %></button>
</form>

</div><aside><section class="chat__presencia" aria-labelledby="chat-presence-title" aria-live="polite" aria-atomic="true">
  <h2 id="chat-presence-title">Conectados (<span id="chat-presence-count">0</span>)</h2>
  <ul id="chat-presence-users" class="chat__presencia-lista">
    <li class="texto-suave">Cargando presencia…</li>
  </ul>
</section><section class="k-chat-connection"><h2>Conexión</h2><p id="chat-connection" class="chat__conexion" role="status" aria-live="polite">Conectando por WebSocket…</p></section></aside></div>
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="/js/chat.js"></script>
