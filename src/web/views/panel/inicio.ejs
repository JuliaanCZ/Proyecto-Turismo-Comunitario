<p class="k-eyebrow k-lined">Pantalla principal</p>
<h1>Hola, <%= principal.displayName.trim().split(/\s+/)[0] %></h1>
<div class="k-dashboard">
  <section class="k-dashboard-offers">
    <h2>Mis ofertas</h2>
    <% if (resumen.available) { %><p class="k-dashboard-number"><%= resumen.total %></p><p class="k-dashboard-label">Ofertas propias</p><% } else { %><p>Resumen no disponible.</p><% } %>
    <a href="/panel/ofertas">Ver listado <span aria-hidden="true">→</span></a>
  </section>
  <a class="k-dashboard-add" href="/panel/ofertas/nueva"><strong>Nueva oferta</strong><span>Publica una experiencia</span><span class="k-dashboard-plus" aria-hidden="true">＋</span></a>
  <section class="k-dashboard-next"><h2>Próxima salida</h2>
    <% if (resumen.next) { %><a href="/panel/ofertas/<%= resumen.next.id %>">
      <%- include('../partials/date-tile', { offer: resumen.next }) %>
      <span><strong><%= resumen.next.title %></strong><small><%= resumen.next.provinceLabel %></small></span>
    </a><% } else { %><p>Aún no tienes salidas próximas.</p><% } %>
  </section>
  <section class="k-dashboard-chat">
    <h2>Chat · Sala general <%- include('../partials/icon', { name: 'chat' }) %></h2>
    <% if (latest) { %><small><%= latest.author.displayName %> · <%= formatEcuadorDateTime(latest.createdAt) %></small><p><%= latest.text %></p><% } else { %><p>Coordina las próximas experiencias con tu equipo.</p><% } %>
    <a href="/panel/chat">Abrir chat <span aria-hidden="true">→</span></a>
  </section>
</div>
