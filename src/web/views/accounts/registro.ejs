<%#
  Registro de cuenta (B1.1). Sin sesión: no lleva CSRF.
  Las contraseñas no se reimprimen tras un error.
%>
<div class="pila">
  <div>
    <h1>Crear cuenta</h1>
    <p>Regístrate para publicar ofertas y usar el chat de la comunidad.</p>
  </div>

  <% if (formError) { %>
  <p class="mensaje mensaje--error" role="alert"><strong>Error:</strong> <%= formError %></p>
  <% } %>

  <form class="formulario" method="post" action="/registro" data-schema="<%= JSON.stringify(schema) %>" autocomplete="on">
    <%- include('../partials/form-field', {
      name: 'displayName',
      label: 'Nombre',
      required: true,
      autocomplete: 'name',
      hint: 'Entre 2 y 80 caracteres.',
      value: values.displayName,
      errors: errors.displayName,
    }) %>
    <%- include('../partials/form-field', {
      name: 'email',
      label: 'Correo',
      type: 'email',
      required: true,
      autocomplete: 'email',
      value: values.email,
      errors: errors.email,
    }) %>
    <%- include('../partials/form-field', {
      name: 'password',
      label: 'Contraseña',
      type: 'password',
      required: true,
      autocomplete: 'new-password',
      hint: 'Entre 10 y 128 caracteres. No uses el correo ni una clave muy común.',
      value: '',
      errors: errors.password,
    }) %>
    <%- include('../partials/form-field', {
      name: 'passwordConfirm',
      label: 'Confirmar contraseña',
      type: 'password',
      required: true,
      autocomplete: 'new-password',
      value: '',
      errors: errors.passwordConfirm,
    }) %>
    <div class="acciones">
      <button class="btn" type="submit">Crear cuenta</button>
      <a class="btn btn--secundario" href="/ingreso">Ya tengo cuenta</a>
    </div>
  </form>
</div>
