<%#
  Solicitud de enlace de recuperación (B1.3). El aviso es el mismo exista o no la cuenta.
  Con sesión: incluye _csrf.
%>
<div class="pila">
  <div>
    <h1>Recuperar contraseña</h1>
    <p>Escribe el correo de tu cuenta y te enviaremos un enlace para crear una contraseña nueva.</p>
  </div>

  <% if (notice) { %>
  <p class="mensaje mensaje--exito" role="status"><strong>Listo:</strong> <%= notice %></p>
  <% } %>

  <% if (formError) { %>
  <p class="mensaje mensaje--error" role="alert"><strong>Error:</strong> <%= formError %></p>
  <% } %>

  <form class="formulario" method="post" action="/recuperar" data-schema="<%= JSON.stringify(schema) %>" autocomplete="on">
    <% if (locals.principal) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
    <%- include('../partials/form-field', {
      name: 'email',
      label: 'Correo',
      type: 'email',
      required: true,
      autocomplete: 'email',
      value: values.email,
      errors: errors.email,
    }) %>
    <div class="acciones">
      <button class="btn" type="submit">Enviar enlace</button>
      <a class="btn btn--secundario" href="/ingreso">Volver a ingresar</a>
    </div>
  </form>
</div>
